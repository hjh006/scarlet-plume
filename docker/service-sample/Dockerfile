FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -o /out/scarlet-service-sample ./cmd/service-sample

FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
COPY --from=build /out/scarlet-service-sample /usr/local/bin/scarlet-service-sample
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["scarlet-service-sample"]
